{
    "compilerOptions": {
        "target": "esnext",
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "allowJs": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "paths": {
            "@/*": ["./src/*"]
        },
        "jsx": "react-jsx",
        "types": ["vite/client"]
    },
    "include": ["src"],
    "exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
