    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.6",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "postcss-preset-env": "^11.5.2",
    "prettier": "^3.9.6",
